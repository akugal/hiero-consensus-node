<?xml version="1.0" encoding="UTF-8"?>
<configuration>
<Loggers>
  <Root level="DEBUG">
    <AppenderRef ref="Console"/>
  </Root>
</Loggers>

<appenders>
  <Console name="Console" target="SYSTEM_OUT">
    <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %X %-5p %c{1} - %m{nolookups}%n"/>
  </Console>
</appenders>
</configuration>